{
  "name": "dsh-mek-comfyui",
  "version": "0.1.2",
  "description": "ComfyUI · 把本地/远程 ComfyUI 接进 dsh：设置配置地址与模型，对话里生成图片，右侧侧边栏看队列进度与图片库",
  "type": "module",
  "main": "./host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./host/*": "./host/*"
  },
  "files": [
    "host",
    "lib",
    "client",
    "scripts",
    "docs",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host": "node tests/host.mjs",
    "test:browser": "node tests/browser.mjs",
    "install:dsh:web": "node scripts/install-web.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "peerDependenciesMeta": {},
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  }
}
